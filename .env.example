# Copy to .env and adjust. Never commit .env.

# Public base URL as seen by clients (behind the TLS reverse proxy). The MCP endpoint is PUBLIC_URL/mcp.
PUBLIC_URL=https://vault.example.com
HOST=127.0.0.1
PORT=8000
# Reverse proxy address(es) whose X-Forwarded-For is trusted (comma separated, or * inside docker networks).
FORWARDED_ALLOW_IPS=127.0.0.1

# Owner password for the OAuth login page. Generate with:  kvault hash-password
OWNER_PASSWORD_HASH=

# Optional static bearer token for scripts / Claude Code (leave empty to disable).
AUTH_TOKEN=

# Persistent state (OAuth clients and tokens). Not derived data: back it up.
STATE_DB_PATH=./data/state.db

# --- Vault and index ---
# Remote vault repository. Leave empty to use a local repository at VAULT_PATH (no push).
VAULT_REPO_URL=
VAULT_BRANCH=main
VAULT_PATH=./data/vault
# Private deploy key for an SSH remote (git@host:owner/vault.git). Needs read and write access.
VAULT_SSH_KEY=
# Pull before / push after every write and pull periodically. false = commit locally only.
VAULT_GIT_SYNC=true
# Identity used for commits made by the server.
GIT_AUTHOR_NAME=Knowledge Vault MCP
GIT_AUTHOR_EMAIL=kvault@localhost
INBOX_DIR=_inbox
TIMEZONE=Europe/Berlin
DB_PATH=./data/index.db
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# false = keyword search only (no model download). Also the automatic fallback if the model fails to load.
EMBEDDINGS_ENABLED=true
# Downloaded model files (about 0.5 GB for e5-small). Keep on a persistent volume.
MODEL_CACHE_PATH=./data/models
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP=150
# PDF/DOCX/HTML files larger than this are not indexed.
MAX_DOCUMENT_MB=25
# Seconds between git pull + incremental reindex; 0 disables the periodic sync.
SYNC_INTERVAL=300
